# Optional local IDE override for Code Inspector. Copy to .env.local when needed.
# CODE_EDITOR=code
# CODE_EDITOR=cursor

# Local Vite demo only: request latency in ms (0..10000; default 150).
# VITE_DEMO_LATENCY_MS=1200
# Fail the first call of each listed operation, then allow Retry. Reset repeats it.
# Operations: loadRequests, buildRoutes, listRequests, listRepresentatives, listHistory,
# listAlerts, getVisitDetails, setVisitStatus, reassignVisit, reportDelay, refuseVisit.
# VITE_DEMO_FAIL_ONCE=loadRequests,listRequests,getVisitDetails
